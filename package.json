{
  "name": "v-content",
  "version": "1.2.2",
  "private": false,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./components/*": {
      "import": "./dist/components/*",
      "require": "./dist/components/*"
    },
    "./vite": {
      "types": "./dist/plugin/bundlers/vite.d.ts",
      "import": "./dist/plugin/bundlers/vite.js",
      "require": "./dist/plugin/bundlers/vite.js"
    },
    "./rollup": {
      "types": "./dist/plugin/bundlers/rollup.d.ts",
      "import": "./dist/plugin/bundlers/rollup.js",
      "require": "./dist/plugin/bundlers/rollup.js"
    },
    "./webpack": {
      "types": "./dist/plugin/bundlers/webpack.d.ts",
      "import": "./dist/plugin/bundlers/webpack.js",
      "require": "./dist/plugin/bundlers/webpack.js"
    },
    "./esbuild": {
      "types": "./dist/plugin/bundlers/esbuild.d.ts",
      "import": "./dist/plugin/bundlers/esbuild.js",
      "require": "./dist/plugin/bundlers/esbuild.js"
    },
    "./rspack": {
      "types": "./dist/plugin/bundlers/rspack.d.ts",
      "import": "./dist/plugin/bundlers/rspack.js",
      "require": "./dist/plugin/bundlers/rspack.js"
    },
    "./farm": {
      "types": "./dist/plugin/bundlers/farm.d.ts",
      "import": "./dist/plugin/bundlers/farm.js",
      "require": "./dist/plugin/bundlers/farm.js"
    },
    "./bun": {
      "types": "./dist/plugin/bundlers/bun.d.ts",
      "import": "./dist/plugin/bundlers/bun.js",
      "require": "./dist/plugin/bundlers/bun.js"
    },
    "./unloader": {
      "types": "./dist/plugin/bundlers/unloader.d.ts",
      "import": "./dist/plugin/bundlers/unloader.js",
      "require": "./dist/plugin/bundlers/unloader.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "playground": "pnpm --filter v-content-playground dev",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.4.3",
    "@shikijs/transformers": "^4.4.3",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "chokidar": "^5.0.0",
    "db0": "^0.3.4",
    "fast-glob": "^3.3.3",
    "hast-util-to-html": "^9.0.5",
    "minimatch": "^10.2.6",
    "rehype": "^13.0.2",
    "rehype-external-links": "^3.0.0",
    "rehype-minify-whitespace": "^6.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-sort-attribute-values": "^5.0.1",
    "rehype-sort-attributes": "^5.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-emoji": "^5.0.2",
    "remark-flexible-toc": "^1.2.6",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdc": "^3.11.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-toc": "^9.0.0",
    "to-vfile": "^8.0.0",
    "unified": "^11.0.5",
    "unimport": "^6.4.0",
    "unist-util-visit": "^5.1.0",
    "unplugin": "^3.3.0",
    "vfile": "^6.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/hast": "^3.0.5",
    "@types/unist": "^3.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "tsdown": "^0.22.14",
    "typescript-eslint": "^8.66.0",
    "unplugin-vue": "^7.2.0"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.10.0"
}
