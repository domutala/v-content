{
  "extends": "@tsconfig/node24/tsconfig.json",

  "compilerOptions": {
    "module": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "outDir": "dist",

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },

  "exclude": ["dist", "node_modules"],
  "include": ["./src/**/*", "./tsdown.config.ts"]
}
